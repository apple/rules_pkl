"""Tests for the toolchains generated by //pkl/private:pkl_toolchains.bzl"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")

# buildifier: disable=bzl-visibility
load("//pkl/private:constants.bzl", "DOC_VERSIONS", "VERSIONS")

# buildifier: disable=bzl-visibility
load("//pkl/private:pkl_toolchains.bzl", "pkl_toolchains_build_file")

def _assert_contains(env, build_file, expected):
    asserts.true(env, expected in build_file, "Expected to find `{}` in:\n{}".format(expected, build_file))

def _only_given_platforms_test(ctx):
    env = unittest.begin(ctx)
    build_file = pkl_toolchains_build_file(["macos-aarch64", "linux-amd64"], ["linux-aarch64"])
    for expected in [
        'name = "pkl_toolchain_macos_aarch64"',
        'name = "pkl_toolchain_linux_amd64"',
        'name = "pkl_doc_toolchain_linux_aarch64"',
    ]:
        _assert_contains(env, build_file, expected)
    for unexpected in ["macos_amd64", "pkl_toolchain_linux_aarch64", "pkl_doc_toolchain_macos_aarch64", "pkl_doc_toolchain_linux_amd64"]:
        asserts.false(env, unexpected in build_file, "Did not expect `{}` in:\n{}".format(unexpected, build_file))
    return unittest.end(env)

only_given_platforms_test = unittest.make(_only_given_platforms_test)

def _toolchain_constraints_test(ctx):
    """`macos-amd64` binaries are only published for Pkl versions before 0.33."""
    env = unittest.begin(ctx)
    build_file = pkl_toolchains_build_file(["macos-amd64"], ["macos-amd64"])
    for expected in [
        'cli = "@pkl-cli-macos-amd64//file"',
        'cli = "@pkl-doc-cli-macos-amd64//file"',
        '"@platforms//os:macos"',
        '"@platforms//cpu:x86_64"',
        '"@bazel_tools//src/conditions:darwin_x86_64": "@pkl-cli-macos-amd64//file:downloaded"',
    ]:
        _assert_contains(env, build_file, expected)
    return unittest.end(env)

toolchain_constraints_test = unittest.make(_toolchain_constraints_test)

def _macos_aarch64_alias_covers_arm64e_test(ctx):
    env = unittest.begin(ctx)
    build_file = pkl_toolchains_build_file(["macos-aarch64"], ["macos-aarch64"])
    for arch in ["darwin_arm64", "darwin_arm64e"]:
        _assert_contains(env, build_file, '"@bazel_tools//src/conditions:{}": "@pkl-cli-macos-aarch64//file:downloaded"'.format(arch))
    return unittest.end(env)

macos_aarch64_alias_covers_arm64e_test = unittest.make(_macos_aarch64_alias_covers_arm64e_test)

def _every_pkl_version_has_toolchains_test(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, sorted(VERSIONS), sorted(DOC_VERSIONS))
    for version in VERSIONS:
        build_file = pkl_toolchains_build_file(VERSIONS[version].keys(), DOC_VERSIONS[version].keys())
        for platform in VERSIONS[version]:
            _assert_contains(env, build_file, 'name = "pkl_toolchain_{}"'.format(platform.replace("-", "_")))
        for platform in DOC_VERSIONS[version]:
            _assert_contains(env, build_file, 'name = "pkl_doc_toolchain_{}"'.format(platform.replace("-", "_")))
    return unittest.end(env)

every_pkl_version_has_toolchains_test = unittest.make(_every_pkl_version_has_toolchains_test)

def pkl_toolchains_test_suite(name):
    """Macro to provide tests within this file to run in BUILD.bazel

    Args:
      name: the name to be provided to `unittest.suite`.
    """
    unittest.suite(
        name,
        only_given_platforms_test,
        toolchain_constraints_test,
        macos_aarch64_alias_covers_arm64e_test,
        every_pkl_version_has_toolchains_test,
    )
